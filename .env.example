# 可选配置（复制为 .env.local 后修改）

# 采集间隔（毫秒），默认 60000（每分钟）
# POLL_INTERVAL_MS=60000

# 同一主播两次抓取的最小间隔（毫秒），默认 20000
# MIN_FETCH_GAP_MS=20000

# 同时抓取的主播数上限，默认 4（避免一个慢请求拖慢所有主播的采样节奏）
# FETCH_CONCURRENCY=4

# 历史采样点保留天数，默认 7
# SNAPSHOT_RETENTION_DAYS=7

# 设置后管理页与增删接口需要密码登录；不设置则管理功能完全开放（适合本地使用）
# ADMIN_PASSWORD=你的管理密码

# SQLite 数据库路径，默认 ./data/liver-dc.db
# DB_PATH=./data/liver-dc.db
